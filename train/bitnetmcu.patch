@@ -288,7 +291,13 @@ class BitQuant:
         else:
             scale = (2.0**(self.bpw-1)) / self.s
 
-        if self.QuantType == 'Ternary': # 1.58bits
+        if self.QuantType == 'Ternary' and self.ternary_zero_frac > 0: # 1.58bits, target sparsity
+            a = w.abs()
+            t = torch.quantile(a.detach().flatten().float(), self.ternary_zero_frac)
+            keep = a > t
+            scale = 1.0 / a[keep].mean().clamp(min=1e-5)   # nonzero weights dequantize to their mean |w|
+            u = w.sign() * keep
+        elif self.QuantType == 'Ternary': # 1.58bits
             u = (w * scale ).round().clamp_(-1, 1)
         elif self.QuantType == 'Binary': # 1 bit
             e = w.mean()
