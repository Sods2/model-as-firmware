         self.act_mantissa = 'none'
         self.log_logit_scale = torch.nn.Parameter(torch.tensor(0.0))   # init 1.0, learned by Adam
         self.table_scale = 0
+        # model-as-firmware patch: >0 -> Ternary layers zero exactly this fraction of weights (smallest |w|),
+        # instead of the BitNet absmean rule. 0 = upstream behaviour.
+        self.ternary_zero_frac = 0.0
 
         if self.QuantType in ['Binary', 'BinarySym']:
