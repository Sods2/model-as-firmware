--- a/exportquant.py
+++ b/exportquant.py
@@ -42,6 +42,13 @@ def load_model(model_name, params):
             kwargs['cnn_width'] = params['cnn_width']
         if 'num_classes' in params:
             kwargs['num_classes'] = params['num_classes']
+        # model-as-firmware patch: forward fc1_quant / ternary_zero_frac (upstream export ignored them,
+        # silently re-quantizing a ternary fc1 as 2bitsym)
+        import inspect
+        sig = inspect.signature(model_class.__init__).parameters
+        for k in ('fc1_quant', 'ternary_zero_frac'):
+            if k in params and k in sig:
+                kwargs[k] = params[k]
         return model_class(**kwargs)
     except AttributeError:
         raise ValueError(f"Model {model_name} not found in models.py")
